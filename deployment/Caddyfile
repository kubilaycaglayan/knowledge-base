{
	auto_https disable_redirects
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:* https://accounts.google.com/gsi/; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

:80 {
	@production {
		host {$DOMAIN:localhost}
		not host localhost
	}
	redir @production https://{host}{uri} permanent

	import security_headers

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:80}
	}
}

{$DOMAIN:localhost} {
	import security_headers

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:80}
	}
}
