[Unit]
Description=Check verified GitHub main and deploy Knowledge Base production
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/knowledge-base-production
ExecStart=%h/.local/bin/knowledge-base-watch-main
Environment=GITHUB_REPOSITORY=kubilaycaglayan/knowledge-base
Environment=DEPLOY_CHECKOUT=%h/knowledge-base-production
Environment=PATH=/mnt/hdd/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
