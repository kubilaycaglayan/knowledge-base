{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "recall-personal-knowledge-base",
  "version": "1.0.4",
  "description": "Recall Personal Knowledge Base brings your work and time insights to ChatGPT and Codex.",
  "author": {
    "name": "Knowledge Base"
  },
  "keywords": [
    "knowledge management",
    "time tracking",
    "notes",
    "MCP"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/getting-started/SKILL.md",
      "interface": {
        "displayName": "Recall Personal Knowledge Base",
        "shortDescription": "Ask about your work and time",
        "longDescription": "Explore tracked work, time by project or label, notes, logs, daily records, boards, and recent activity through your existing Knowledge Base MCP connection. Read-only.",
        "developerName": "Knowledge Base",
        "category": "Productivity",
        "capabilities": [
          "Search",
          "Read"
        ],
        "websiteURL": "https://knowledgebase.blaqc.space",
        "supportURL": "https://github.com/kubilaycaglayan/knowledge-base/issues",
        "privacyPolicyURL": "https://github.com/kubilaycaglayan/knowledge-base/blob/fix/plugin-listing-metadata/codex-plugin/privacy-policy.md",
        "termsOfServiceURL": "https://github.com/kubilaycaglayan/knowledge-base/blob/fix/plugin-listing-metadata/codex-plugin/terms-of-service.md",
        "brandColor": "#15351F",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
