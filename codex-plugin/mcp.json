{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "knowledge-base": {
      "type": "streamable-http",
      "url": "https://knowledgebase.blaqc.space/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "knowledge-base-openai",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "defaultScopes": [
              "kb:notes:read",
              "kb:logs:read",
              "kb:calendar:read",
              "kb:sessions:read",
              "kb:activity:read",
              "kb:reports:read",
              "kb:paths:read",
              "kb:labels:read",
              "kb:boards:read"
            ]
          }
        }
      }
    }
  }
}
