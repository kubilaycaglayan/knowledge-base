POSTGRES_DB=know
POSTGRES_USER=know
POSTGRES_PASSWORD=replace-with-a-local-password
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_COUNT=168
# Neon is a remote snapshot target only; it is never an application datasource.
NEON_BACKUP_ENABLED=1
NEON_DATABASE_URL=postgresql://backup-user:replace-with-password@ep-example.us-east-2.aws.neon.tech/knowledge-base-backup?sslmode=require
# Optional pooled connectivity-check endpoint; dump/restore uses the direct URL above.
NEON_DATABASE_URL_POOLED=postgresql://backup-user:replace-with-password@ep-example-pooler.us-east-2.aws.neon.tech/knowledge-base-backup?sslmode=require
NEON_BACKUP_DATABASE_CONFIRM=1
JWT_SECRET=replace-with-at-least-32-random-characters
DOMAIN=example.com
KNOW_API_BASE=https://example.com/api/v1
CORS_ORIGINS=https://example.com,chrome-extension://replace-with-extension-id
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# Optional Google Identity Services client ID. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
# Opt in only while testing a Debug iOS build on the same private Wi-Fi.
# Set IOS_LAN_API_URL to your Mac's LAN URL, for example http://<mac-lan-ip>:8080.
IOS_LAN_API=0
IOS_LAN_API_BIND_ADDRESS=0.0.0.0
IOS_LAN_API_URL=
# Optional stable public key for the unpacked local extension ID. Generate it once;
# do not commit the generated value to this example file.
CHROME_EXTENSION_KEY=
